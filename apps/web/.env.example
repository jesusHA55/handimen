# Supabase (Project Settings → API). Safe to expose the URL + anon key to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_. Bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL used for auth redirects / emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
